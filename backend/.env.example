# ===================================================================
# AI Fake Job Detector - Backend Environment Variables
# ===================================================================
# Instructions:
# 1. Copy this file and rename it to .env in the backend/ directory:
#    cp .env.example .env
# 2. Add your Google Gemini API key below (get one at https://aistudio.google.com/)
# 3. Never commit your actual .env file with real API keys to Git!

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port and Host
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (Frontend URL for local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
